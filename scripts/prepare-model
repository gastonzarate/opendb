#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $# -eq 1 ]]; then
  expected=d0aefc589e25df26b75d45eaa3b7205cad850ceeaaef82c6b98b04b166b992d4
  actual=$(sha256sum -- "$1")
  if [[ ${actual%% *} != "$expected" ]]; then
    echo 'GGUF checksum differs from the pinned Pi artifact.' >&2
    exit 1
  fi
  mkdir -p .models
  target=.models/granite-97m-r2-q8_0.gguf
  if [[ $(realpath "$1") != $(realpath -m "$target") ]]; then
    cp -- "$1" "$target"
  fi
fi
sha256sum --check docs/implementation/model.sha256
