{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDB ingestion operation v1",
  "description": "Call catalog first. Server also validates PostgreSQL DDL, actual column types, prior returned references and database constraints. Maximum canonical JSON payload: 4000000 bytes.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "expected_schema_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000000,
          "pattern": "\\S"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": [
        "content",
        "media_type"
      ],
      "additionalProperties": false
    },
    "statements": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100000,
        "pattern": "\\S",
        "description": "Exactly one parent-policy-approved transactional DDL statement per item; explicitly qualify all relations with data."
      }
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "required": [
    "version",
    "idempotency_key",
    "expected_schema_fingerprint",
    "source",
    "statements",
    "records",
    "annotations"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000000
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "numeric"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "Finite exact decimal string; JSON floating point numbers are rejected."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "float"
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "time"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "ISO local time, without timezone."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "description": "ISO local date and time with T, without timezone."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "timestamptz"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "ISO date and time with T and an explicit UTC offset."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "uuid"
            },
            "value": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "jsonb"
            },
            "value": {
              "description": "Any finite JSON value, or null (SQL NULL). NUL characters are rejected."
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$ref": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}\\.[A-Za-z_][A-Za-z0-9_]{0,62}$",
              "description": "ref.column from an earlier record's explicitly returned column."
            }
          },
          "required": [
            "$ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "description": "Bare table name in data; schema-qualified or arbitrary SQL identifiers are rejected."
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "returning": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "on_conflict": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "update": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "description": "Explicit columns to replace with supplied values; all conflict/update columns must occur in values."
            }
          },
          "required": [
            "columns",
            "update"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ref",
        "table",
        "values",
        "returning"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "column": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
        },
        "description": {
          "type": "string",
          "maxLength": 10000,
          "description": "Clear business meaning of the table, or the meaning of a column."
        },
        "metadata": {
          "type": "object",
          "properties": {
            "purpose": {
              "type": "string",
              "maxLength": 10000
            },
            "units": {
              "type": "string",
              "maxLength": 10000
            },
            "conventions": {
              "type": "string",
              "maxLength": 10000
            },
            "display_name": {
              "type": "string",
              "maxLength": 200,
              "description": "Optional table-level business label; never a SQL identifier. Empty uses the catalog fallback."
            },
            "attributes_summary": {
              "type": "string",
              "maxLength": 2000,
              "description": "Optional concise table-level summary of fields; empty uses visible column names/descriptions."
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "table",
        "description",
        "metadata"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "column"
            ]
          },
          "then": {
            "properties": {
              "metadata": {
                "properties": {
                  "display_name": false,
                  "attributes_summary": false
                }
              }
            }
          }
        }
      ]
    }
  }
}
